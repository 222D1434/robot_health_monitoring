<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
    <name>robot_health_monitor</name>
    <version>1.0.0</version>
    <description>Sistema de monitorización de salud para TurtleBot3</description>
    <maintainer email="tucorreo@ejemplo.com">ramyelias</maintainer>
    <license>Apache-2.0</license>

    <!-- Dependencias de ROS 2 -->
    <depend>rclpy</depend>
    <depend>std_msgs</depend>
    <depend>diagnostic_msgs</depend>
    <depend>sensor_msgs</depend>

    <!-- Dependencias de Python -->
    <exec_depend>python3-psutil</exec_depend>
    <exec_depend>python3-yaml</exec_depend>
    <exec_depend>python3-flask</exec_depend>

    <!-- Dependencias de Test -->
    <test_depend>ament_copyright</test_depend>
    <test_depend>ament_flake8</test_depend>
    <test_depend>ament_pep257</test_depend>
    <test_depend>python3-pytest</test_depend>

    <export>
        <build_type>ament_python</build_type>
    </export>
</package>

